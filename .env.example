# Supabase project settings. Only NEXT_PUBLIC_ values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Server-only key. Never use a NEXT_PUBLIC_ prefix for this value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Canonical origin used in invitation and password-reset links.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional local-only authentication. It is always disabled in production.
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAIL=dev@korkembooks.local
DEV_AUTH_PASSWORD=replace-with-a-local-password
DEV_AUTH_SESSION_TOKEN=replace-with-a-random-local-token
